<?xml version="1.0" encoding="utf-8"?>
<manifest version="4.0" type="framework">

    <!-- Service Manager (HIDL) -->
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IServiceManager/default</fqname>
    </hal>

    <!-- Memory mapper (HIDL) -->
    <hal format="hidl">
        <name>android.hidl.memory</name>
        <transport arch="32+64">passthrough</transport>
        <fqname>@1.0::IMapper/ashmem</fqname>
    </hal>

    <!-- Token manager (HIDL) -->
    <hal format="hidl">
        <name>android.hidl.token</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITokenManager/default</fqname>
    </hal>

    <!-- Display service (HIDL) -->
    <hal format="hidl">
        <name>android.frameworks.displayservice</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IDisplayService/default</fqname>
    </hal>

    <!-- Scheduler service (HIDL) -->
    <hal format="hidl" max-level="5">
        <name>android.frameworks.schedulerservice</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISchedulingPolicyService/default</fqname>
    </hal>

    <!-- Sensor service -->
    <hal format="aidl">
        <name>android.frameworks.sensorservice</name>
        <transport>hwbinder</transport>
        <fqname>ISensorManager/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.frameworks.sensorservice</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISensorManager/default</fqname>
    </hal>

    <!-- Netd service (HIDL) -->
    <hal format="hidl">
        <name>android.system.net.netd</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::INetd/default</fqname>
    </hal>

    <!-- Keystore2 service (AIDL) -->
    <hal format="aidl">
        <name>android.system.keystore2</name>
        <transport>hwbinder</transport>
        <fqname>IKeystoreService/default</fqname>
    </hal>

    <!-- Wifi Keystore (legacy HIDL) -->
    <hal format="hidl">
        <name>android.system.wifi.keystore</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IKeystore/default</fqname>
    </hal>
    
    
    <hal format="hidl">
        <name>vendor.lenovo.hardware.touchscreen</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITouchscreen/default</fqname>
    </hal>
    
   
    <hal format="aidl">
        <name>android.hardware.light</name>
        <fqname>ILights/default</fqname>
    </hal>

    
    <!-- Native netutils-wrapper -->
    <hal format="native">
        <name>netutils-wrapper</name>
        <version>1.0</version>
    </hal>
    

        
    <!-- System SDK versions -->
    <system-sdk>
        <version>29</version>
        <version>30</version>
        <version>31</version>
        <version>32</version>
        <version>33</version>
        <version>34</version>
    </system-sdk>

</manifest>

